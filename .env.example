# Пример настроек Ramacord. Скопируйте в .env (или выполните `npm run setup`)
# и заполните своими значениями. Файл .env нельзя коммитить: в нём ключи.
#
# Значения из .env читаются при запуске через `npm start`.
# Переменная, уже заданная в окружении, имеет приоритет над файлом.

# Порт и адрес. За обратным прокси с HTTPS оставьте 127.0.0.1,
# иначе сервер будет доступен напрямую, без шифрования.
PORT=3000
HOST=127.0.0.1

# development — обычный запуск, production — проверки на месте
# (сервер не стартует без LIVEKIT_* и INVITE_CODE).
NODE_ENV=development

# Ник администратора. Пусто — администратором становится первый
# зарегистрированный аккаунт. Регистр не важен.
ADMIN_NAME=

# Код приглашения для регистрации. Пусто — регистрация открыта всем.
# Минимум 12 символов (в админ-панели короче не примет).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(6).toString('hex'))"
# Код можно сменить позже в админ-панели, вкладка «Доступ».
INVITE_CODE=

# LiveKit. Для локальной проверки подойдёт `livekit-server --dev`
# (ключи devkey/secret). Для продакшена — свои ключи и wss:// адрес.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Адрес управления LiveKit (заглушка участника администратором).
# Пусто — берётся из LIVEKIT_URL с заменой ws на http.
LIVEKIT_API_URL=

# Срок токена голоса. LiveKit сам продлевает его, пока участник в комнате,
# поэтому длинные звонки не рвутся. Короткий срок ограничивает окно, в которое
# выгнанный человек может вернуться со сохранённым токеном.
VOICE_TOKEN_TTL=10m

# ===== Лимиты =====
# Загрузки: файлов в час с аккаунта, мегабайт за сутки на аккаунт и на весь сервер.
# Файл больше 25 МБ не примется всегда — это зашито в коде.
UPLOAD_PER_HOUR=30
UPLOAD_USER_MB=250
UPLOAD_TOTAL_MB=2048

# Регистрация: сколько аккаунтов можно создать с одного IP и всего за сутки.
REG_LIMIT_IP=3
REG_LIMIT_TOTAL=20
