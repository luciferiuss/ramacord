{
  "name": "ramacord",
  "version": "1.0.1",
  "description": "Самостоятельно размещаемый чат с голосовыми каналами: Express, Socket.IO, LiveKit и SQLite",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "setup": "node scripts/setup.mjs",
    "check": "node --check index.js && node --check db.js",
    "test": "node --check index.js && node --check db.js && node test/all.js"
  },
  "keywords": [
    "chat",
    "voice",
    "livekit",
    "socket.io",
    "self-hosted",
    "sqlite"
  ],
  "author": "luciferiuss (https://github.com/luciferiuss)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciferiuss/ramacord.git"
  },
  "bugs": {
    "url": "https://github.com/luciferiuss/ramacord/issues"
  },
  "homepage": "https://github.com/luciferiuss/ramacord#readme",
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "livekit-client": "^2.24.0",
    "livekit-server-sdk": "^2.19.3",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4"
  },
  "engines": {
    "node": ">=22.13"
  }
}
